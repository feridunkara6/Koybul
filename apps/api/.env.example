# Şablon — gerçek değerler asla repo'ya girmez (docs/28 §5).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://dockly:dockly@localhost:5432/dockly_dev
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=10000
# Auth (Faz 2.1) — gerçek değerler SSM'den (docs/28 §5); yerelde test anahtarı üret:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   openssl pkey -in jwt.pem -pubout -out jwt.pub
# ve PEM içeriklerini aşağıdaki iki değişkene ata (örneğe PEM YAZILMAZ — gitleaks tetikler).
FIREBASE_PROJECT_ID=moorira
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_KID=dockly-k1
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=60
AUTH_RATE_LIMIT_PER_MIN=10
# Genel hız sınırları — IP başına dakikalık tavan.
READ_RATE_LIMIT_PER_MIN=300
WRITE_RATE_LIMIT_PER_MIN=60
# MODERATÖR LİSTESİ — virgülle ayrılmış e-postalar. Buradaki adresle GİRİŞ
# YAPILDIĞI AN hesap moderatöre yükseltilir ve Profil'de "Moderasyon" satırı
# açılır. Boş bırakılırsa kimse otomatik yükseltilmez (ve incelemeye düşen
# notları onaylayacak kimse olmaz).
MODERATOR_EMAILS=
